# ================================================================
# PayGate — Sozlamalar namunasi (.env.example)
#
# Diqqat: .env faylida hech qanday karta raqamlari, maxfiy kalitlar
# yoki parollar yozilmaydi. Faqat bitta BOT_TOKEN yetarli!
# Qolgan barcha sozlamalar Telegram bot orqali boshqariladi.
# ================================================================

# [MAJBURИЙ] Telegram boshqaruv boti tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# ----------------------------------------------------------------
# Quyidagi sozlamalar ixtiyoriy (o'zgartirmasa ham ishlayveradi):
# ----------------------------------------------------------------

# Server porti va manzili (standart: 8000)
PORT=8000
HOST=0.0.0.0

# Serverning internetdagi ochiq manzili (Botda /url orqali ham o'rnatiladi)
BASE_URL=http://localhost:8000

# Administrator Telegram ID raqami (Render qayta yuklanganda bazani Telegram'dan avtomatik tiklash uchun)
ADMIN_CHAT_ID=123456789

# Ilova nomi
APP_NAME=PayGate
